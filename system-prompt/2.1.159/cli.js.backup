`)}function Sf(H,$,q){let K=H.match(e9H);if(!K)return{frontmatter:{},content:H};let _=K[1]||"",z=H.slice(K[0].length),A=(O)=>{return O},Y={};try{Y=A(OQK(t9H(_)))}catch{try{let O=y95(_);Y=A(OQK(t9H(O)))}catch(O){let f=$?` in ${$}`:"";N(`Failed to parse YAML frontmatter${f}: ${O instanceof Error?O.message:O}`,{level:"warn"})}}return{frontmatter:Y,content:z}}function OQK(H){if(H&&typeof H==="object"&&!Array.isArray(H))return H;return{}}function Pj$(H){if(Array.isArray(H))return H.flatMap(Pj$);if(typeof H!=="string")return[];let $=[],q="",K=0;for(let z=0;z<H.length;z++){let A=H[z];if(A==="{")K++,q+=A;else if(A==="}")K--,q+=A;else if(A===","&&K===0){let Y=q.trim();if(Y)$.push(Y);q=""}else q+=A}let _=q.trim();if(_)$.push(_);return $.filter((z)=>z.length>0).flatMap((z)=>MQK(z))}function MQK(H){let $=H.match(/^([^{]*)\{([^}]+)\}(.*)$/);if(!$)return[H];let q=$[1]||"",K=$[2]||"",_=$[3]||"",z=K.split(",").map((Y)=>Y.trim()),A=[];for(let Y of z){let O=q+Y+_,f=MQK(O);A.push(...f)}return A}function v68(H){if(H===void 0||H===null)return;let $=typeof H==="number"?H:parseInt(String(H),10);if(Number.isInteger($)&&$>0)return $;return}function uh(H,$,q){if(H==null)return null;if(typeof H==="string")return H.trim()||null;if(typeof H==="number"||typeof H==="boolean")return String(H);let K=q?`${q}:${$}`:$??"unknown";return N(`Description invalid for ${K} - omitting`,{level:"warn"}),null}function k68(H){let $=(q)=>q!=null&&typeof q==="object"&&!Array.isArray(q)?Object.keys(q):[];return aq([...Object.keys(H),...$(H.metadata),...$(H.experimental)])}function tgH(H){return H===!0||H==="true"}function eVH(H){if(H===!0||H==="true")return!0;if(H===!1||H==="false")return!1;return}function N68(H,$){if(H==null)return;let q=String(H).trim().toLowerCase();if(q==="")return;if(fQK.includes(q))return q;N(`Frontmatter 'shell: ${H}' in ${$} is not recognized. Valid values: ${fQK.join(", ")}. Falling back to bash.`,{level:"warn"});return}var E95,e9H,fQK;var $2=T(()=>{cH();YQK();E95=/[{}[\]*&#!|>%@`]|: /;e9H