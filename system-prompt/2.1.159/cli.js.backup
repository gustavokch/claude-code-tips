When called with the default mode='check': if a local ONBOARDING.md is present, uploads it to the most-recently-updated org guide (or creates one if none exist) and returns a fresh link. If no local file is present, returns the existing link without uploading (status: has_existing).`;var _w4={};L$(_w4,{ShareOnboardingGuideTool:()=>cS_});async function Kd6(){let H=await $d6();if(H.length===0)return;return H.reduce(($,q)=>$.updated_at>q.updated_at?$:q)}function _d6(H,$,q,K){let _=K?`

Close with: "Here's your onboarding guide: ${$}" followed by the send-to-teammates line.`:"";return{data:{status:H,share_url:$,short_code:q,message:`Share link ${H}: ${$} (short_code: ${q})${_}`}}}function PRH(H){return{data:{status:"unavailable",message:H}}}var BH$,zd6,gS_,dS_,iV$="ONBOARDING.md",gG8=65536,cS_;var zw4=T(()=>{I6();D$();QG8();BK();W$();BH$=require("fs/promises"),zd6=require("path"),gS_=hH(()=>y.strictObject({mode:y.enum(["check","update","create","delete"]).default("check").describe("'check' (default): if ONBOARDING.md is present locally, uploads it to the most-recent guide (creates one if none exist); otherwise reports the existing link without uploading. 'update': upload to a specific guide by short_code. 'create': always make a new link. 'delete': remove a guide."),short_code:y.string().regex(/^[A-Za-z0-9_-]{1,64}$/).optional().describe("Short code of a specific guide to target (returned by a previous call). Honored by check, update, and delete \u2014 skips the org-wide lookup and targets this guide directly.")})),dS_=hH(()=>y.object({status:y.enum(["created","updated","deleted","has_existing","unavailable"]),share_url:y.string().optional(),short_code:y.string().optional(),message:y.string()})),cS_=SK({name:nV$,searchHint:"upload ONBOARDING.md and get a team share link",maxResultSizeChars:1000,async description(){return qd6},isEnabled(){return mH$()},isConcurrencySafe(){return!1},isReadOnly(){return!1},get inputSchema(){return gS_()},get outputSchema(){return dS_()},async validateInput(){return{result:!0}},async prompt(){return qd6},toAutoClassifierInput(H){return`share onboarding guide (mode: ${H.mode??"check"})`},isDestructive(H){return H.mode==="delete"},renderToolUseMessage(H){return H.mode&&H.mode!=="check"?H.mode:null},async call({mode:H="check",short_code:$}){if(H==="delete")try{let z=$??(await Kd6())?.short_code;if(!z)return PRH("No guide found for this org to delete.");return await Kw4(z),{data:{status:"deleted",message:`Guide ${z} delete